generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Video {
  id        String   @id @default(cuid())
  topic     String
  time      String
  videoName String
  createdAt DateTime @default(now())
}
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  isPremium           Boolean   @default(false)
  subscriptionExpires DateTime?
}

